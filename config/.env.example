# =============================================
# CONFIGURACIÓN — Bot de Pronósticos
# Copia este archivo a .env y rellena los valores
# =============================================

# --- TELEGRAM ---
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- SUPABASE ---
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# --- THE ODDS API (500 req/mes gratis) ---
# Registro en: https://the-odds-api.com/
ODDS_API_KEY=your_odds_api_key_here

# --- API-FOOTBALL via RapidAPI (100 req/día gratis) ---
# Registro en: https://rapidapi.com/api-sports/api/api-football
RAPIDAPI_KEY=your_rapidapi_key_here

# --- CONFIGURACIÓN DEL BOT ---
# Umbral mínimo de EV para enviar un pick (5% = 0.05)
EV_THRESHOLD=0.05
# Fracción de Kelly a usar (0.25 = quarter Kelly)
KELLY_FRACTION=0.25
# Bankroll inicial en tu moneda (solo para cálculo de sizing)
BANKROLL=100

# --- LIGAS A MONITOREAR ---
# IDs de API-Football: 39=Premier League, 140=LaLiga, 135=Serie A,
# 78=Bundesliga, 61=Ligue1, 2=Champions, 3=Europa League
FOOTBALL_LEAGUES=39,140,135,78,61

# --- ENTORNO ---
ENV=development
LOG_LEVEL=INFO
